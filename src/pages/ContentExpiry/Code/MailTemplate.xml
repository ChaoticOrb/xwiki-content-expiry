<?xml version="1.1" encoding="UTF-8"?>
<!-- Digest email, one per person per run. Velocity variables are listed in docs/design.md. -->
<xwikidoc reference="ContentExpiry.Code.MailTemplate">
  <title>Content Expiry warning email</title>
  <object>
    <className>XWiki.Mail</className>
    <property><language>en</language></property>
    <property><subject>#if ($count == 1)A page on $wikiName is due to expire#{else}$count pages on $wikiName are due to expire#end</subject></property>
    <property><text file="mail.text.vm"/></property>
    <property><html file="mail.html.vm"/></property>
  </object>
</xwikidoc>
